# Local dev only — read by cms-web when you run `npm run dev` outside Docker.
# Deploying via Docker Compose? This file is NOT read by docker-compose.yml —
# fill in NEXT_PUBLIC_API_URL in the root .env.example instead (it's passed as
# a build arg there, since cms-web has no real .env of its own for local dev
# unless you create one — this template's value falls back automatically).

# Base URL of the deployed cms-api, no trailing slash.
NEXT_PUBLIC_API_URL=https://api.example.com
