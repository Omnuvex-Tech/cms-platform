generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DB_URI")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("product_owners")
}

model Faq {
  id        Int      @id @default(autoincrement())
  question  Json     @default("{}")
  answer    Json     @default("{}")
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order     Int      @default(0)

  @@map("faqs")
}


model TestimonialsSection {
  id           Int           @id @default(autoincrement())
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  description  Json          @default("{}")
  title        Json          @default("{}")
  testimonials Testimonial[]

  @@map("testimonials_sections")
}

model Testimonial {
  id        Int                 @id @default(autoincrement())
  image     String
  order     Int                 @default(0)
  sectionId Int
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  altText   String              @default("")
  quote     Json                @default("{}")
  role      Json                @default("{}")
  company   Json                @default("{}")
  name      Json                @default("{}")
  section   TestimonialsSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@map("testimonials")
}

model VacancyCategory {
  id        Int       @id @default(autoincrement())
  name      Json      @default("{}")
  order     Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  vacancies Vacancy[]
}

model Vacancy {
  id                 Int             @id @default(autoincrement())
  title              Json            @default("{}")
  tags               Json            @default("[]")
  isNew              Boolean         @default(false)
  isVisible          Boolean         @default(true)
  order              Int             @default(0)
  categoryId         Int
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  aboutRole          Json?
  closingDate        DateTime?
  isDateVisible      Boolean         @default(true)
  newLabel           Json?
  requirements       Json            @default("[]")
  requirementsType   BulletType      @default(BULLET)
  responsible        Json            @default("[]")
  responsibleType    BulletType      @default(BULLET)
  skills             Json            @default("[]")
  isStartDateVisible Boolean         @default(true)
  startDate          DateTime?
  slug               String          @unique
  category           VacancyCategory @relation(fields: [categoryId], references: [id])
   seoTitle       Json?
  seoDescription Json?
  seoKeywords    Json?
}

model VacancyPageHeader {
  id        Int      @id @default(autoincrement())
  title     Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VacancySettings {
  id                     Int      @id @default(autoincrement())
  backLabel              Json     @default("{}")
  applyTitle             Json     @default("{}")
  aboutRoleLabel         Json     @default("{}")
  skillsLabel            Json     @default("{}")
  responsibleLabel       Json     @default("{}")
  requirementsLabel      Json     @default("{}")
  email                  String   @default("")
  emailHref              String   @default("")
  phone                  String   @default("")
  phoneHref              String   @default("")
  location               Json     @default("{}")
  emailLabel             Json     @default("{}")
  phoneLabel             Json     @default("{}")
  locationLabel          Json     @default("{}")
  formCvLabel            Json     @default("{}")
  formCvPlaceholder      Json     @default("{}")
  formEmailLabel         Json     @default("{}")
  formEmailPlaceholder   Json     @default("{}")
  formMessageLabel       Json     @default("{}")
  formMessagePlaceholder Json     @default("{}")
  formNameLabel          Json     @default("{}")
  formNamePlaceholder    Json     @default("{}")
  formPhoneLabel         Json     @default("{}")
  formPhonePlaceholder   Json     @default("{}")
  formSubmitLabel        Json     @default("{}")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("vacancy_settings")
}

model VacancySubmission {
  id           Int      @id @default(autoincrement())
  name         String
  email        String
  phone        String
  message      String?
  cvUrl        String
  vacancyId    Int?
  vacancyTitle String?
  createdAt    DateTime @default(now())

  @@map("vacancy_submissions")
}

model Portfolio {
  id            Int      @id @default(autoincrement())
  title         Json     @default("{}")
  slug          String   @unique
  tags          String[]
  coverImage    String
  coverImageAlt Json     @default("{}")
  sections      Json     @default("[]")
  order         Int      @default(0)
  isVisible     Boolean  @default(true)
  isHomepage    Boolean  @default(false)

  seoTitle       Json?
  seoDescription Json?
  seoKeywords    Json?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("portfolios")
}

model PortfolioSettings {
  id              Int      @id @default(autoincrement())
  sectionTitle    Json
  dropdownLabel   Json
  moreButtonLabel Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PartnerSection {
  id          Int       @id @default(autoincrement())
  title       Json      @default("{}")
  description Json      @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  partners    Partner[]

  @@map("partner_sections")
}
model Partner {
  id         Int            @id @default(autoincrement())
  image      String
  altText    Json           @default("{}")
  name       Json           @default("{}")
  order      Int            @default(0)
  isHomepage Boolean        @default(false)
  sectionId  Int
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  isVisible  Boolean        @default(true)
  section    PartnerSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@map("partners")
}

model Service {
  id                    Int      @id @default(autoincrement())
  number                String
  slug                  String   @unique
  badge                 Json     @default("{}")
  title                 Json     @default("{}")
  description           Json     @default("{}")
  image                 String
  imageAlt              Json     @default("{}")
  gif                   String?
  features              Json     @default("[]")
  portfolioButtonText   Json     @default("{}")
  portfolioButtonLink   String?
  portfolioButtonNewTab Boolean  @default(false)
  detailButtonText      Json     @default("{}")
  detailButtonLink      String?
  detailButtonNewTab    Boolean  @default(false)
  order                 Int      @default(0)
  isVisible             Boolean  @default(true)
  sections              Json     @default("[]")
  seoTitle       Json?
  seoDescription Json?
  seoKeywords    Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("services")
}


model BlogAuthor {
  id           Int      @id @default(autoincrement())
  name         Json     @default("{}")
  role         Json     @default("{}")
  avatar       String?
  avatarAlt    Json     @default("{}")
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  bio          Json     @default("{}")
  linkedinHref String?
  skills       Json     @default("[]")
  skillsTitle  Json     @default("{}")
  slug         String?  @unique
  linkedinIcon String?
    seoTitle       Json?
  seoDescription Json?
  seoKeywords    Json?
  isOurTeam    Boolean  @default(false)
  isVisible    Boolean  @default(true)
  blogs        Blog[]
  @@map("blog_authors")
}
model BlogCategory {
  id        Int      @id @default(autoincrement())
  label     Json     @default("{}")
  slug      String   @unique
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  blogs     Blog[]
  @@map("blog_categories")
}
model Blog {
  id                 Int           @id @default(autoincrement())
  title              Json          @default("{}")
  slug               String        @unique
  badge              Json          @default("{}")
  excerpt            Json          @default("{}")
  coverImage         Json @default("{}")
  coverImageAlt      Json          @default("{}")
  publishedAt        DateTime      @default(now())
  isVisible          Boolean       @default(true)
  isFeaturedMain     Boolean       @default(false)
  isFeaturedSide     Boolean       @default(false)
  isPickOfWeek       Boolean       @default(false)
  isPreview          Boolean       @default(false)
  isGrid             Boolean       @default(false)
  sections           Json          @default("[]")
  authorId           Int?
  categoryId         Int?
  order              Int           @default(0)
   seoTitle       Json?
  seoDescription Json?
  seoKeywords    Json?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  isAuthorList       Boolean       @default(false)
  isAuthorPreview    Boolean       @default(false)
  isHomeVisible      Boolean       @default(false)
  authorListPinnedAt DateTime?
  author             BlogAuthor?   @relation(fields: [authorId], references: [id])
  category           BlogCategory? @relation(fields: [categoryId], references: [id])
  @@map("blogs")
}
model BlogSettings {
  id            Int      @id @default(autoincrement())
  pageTitle     Json     @default("{}")
  buttonText    Json     @default("{}")
  buttonLink    String   @default("/portfolio")
  buttonNewTab  Boolean  @default(false)
  quoteText     Json     @default("{}")
  quoteImage    Json  @default("{}")
  quoteImageAlt Json     @default("{}")
  searchPlaceholder Json @default("{}")
  categoriesLabel   Json @default("{}")
  pickOfWeekLabel   Json @default("{}")
  moreBlogsButtonText Json @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@map("blog_settings")
} 

model OurTeamSettings {
  id          Int      @id @default(autoincrement())
  title       Json     @default("{}")
  description Json     @default("{}")
  moreBtn Json @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("our_team_settings")
}

model AboutSettings {
  id              Int      @id @default(autoincrement())
  heroImage       String?
  heroImageAlt    Json     @default("{}")
  heroBadge       Json     @default("{}")
  heroTitle       Json     @default("{}")
  heroParagraphs  Json     @default("[]")
  storyBlocks     Json     @default("[]")
  teamTitle       Json     @default("{}")
  teamDescription Json     @default("{}")
  teamCtaLabel    Json     @default("{}")
  teamCtaHref     String?
  heroStats Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("about_settings")
}

model NavbarSettings {
  id           Int       @id @default(autoincrement())
  logoImage    String?
  logoImageAlt Json      @default("{}")
  showSearch   Boolean   @default(true)
  showLang     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  links        NavLink[]

  @@map("navbar_settings")
}

model NavLink {
  id           Int            @id @default(autoincrement())
  label        Json           @default("{}")
  href         String
  order        Int            @default(0)
  isVisible    Boolean        @default(true)
  openInNewTab Boolean        @default(false)
  navbarId     Int
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  navbar       NavbarSettings @relation(fields: [navbarId], references: [id], onDelete: Cascade)

  @@map("nav_links")
}

model FooterSettings {
  id            Int                @id @default(autoincrement())
  logoImage     String?
  logoAlt       Json               @default("{}")
  description   Json               @default("{}")
  copyrightText Json               @default("{}")
  privacyText   Json               @default("{}")
  locationLabel Json               @default("{}")
  phoneLabel    Json               @default("{}")
  emailLabel    Json               @default("{}")
  locationValue Json               @default("{}")
  phoneValue    Json               @default("{}")
  emailValue    Json               @default("{}")
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  navLinks      FooterNavLink[]
  socialLinks   FooterSocialLink[]

  @@map("footer_settings")
}

model FooterNavLink {
  id           Int            @id @default(autoincrement())
  label        Json           @default("{}")
  href         String
  order        Int            @default(0)
  isVisible    Boolean        @default(true)
  openInNewTab Boolean        @default(false)
  footerId     Int
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  footer       FooterSettings @relation(fields: [footerId], references: [id], onDelete: Cascade)

  @@map("footer_nav_links")
}

model FooterSocialLink {
  id        Int            @id @default(autoincrement())
  icon      String?
  href      String
  order     Int            @default(0)
  isVisible Boolean        @default(true)
  footerId  Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  footer    FooterSettings @relation(fields: [footerId], references: [id], onDelete: Cascade)

  @@map("footer_social_links")
}

model ContactSubmission {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String
  service   String?
  budget    String?
  timeline  String?
  message   String
  createdAt DateTime @default(now())

  @@map("contact_submissions")
}

model HeroSettings {
  id                  Int      @id @default(autoincrement())
  title               Json     @default("{}")
  description         Json     @default("{}")
  primaryBtnText      Json     @default("{}")
  primaryBtnLink      String   @default("/contact")
  primaryBtnNewTab    Boolean  @default(false)
  secondaryBtnText    Json     @default("{}")
  secondaryBtnLink    String   @default("/services")
  secondaryBtnNewTab  Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("hero_settings")
}

model HomeSettings {
  id                    Int      @id @default(autoincrement())
  projectsTitle         Json     @default("{}")
  projectsBtnText       Json     @default("{}")
  projectsBtnLink       String   @default("/portfolio")
  projectsBtnNewTab     Boolean  @default(false)
  teamTitle             Json     @default("{}")
  teamBtnText           Json     @default("{}")
  teamBtnLink           String   @default("/team")
  teamBtnNewTab         Boolean  @default(false)
  teamImage             String?
  blogsTitle            Json     @default("{}")
  blogsBtnText          Json     @default("{}")
  blogsBtnLink          String   @default("/blog")
  blogsBtnNewTab        Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("home_settings")
}

model PageMeta {
  id             String   @id @default(cuid())
  pageKey        String   @unique
  seoTitle       Json?
  seoDescription Json?
  seoKeywords    Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}


enum BulletType {
  BULLET
  NUMBERED
  DASH
}

// ─── Pulse CMS ──────────────────────────────────────────────

model PulseArticle {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           Json     @default("{}")
  category        Json     @default("{}")
  date            DateTime @default(now())
  coverImage      String?
  excerpt         Json?
  authorId        String?
  author          PulseAuthor? @relation(fields: [authorId], references: [id])
  keywords        PulseKeyword[]
  blocks          Json     @default("[]")
  metaTitle       Json?
  metaDescription Json?
  featured        Boolean  @default(false)
  published       Boolean  @default(false)
  headerPosition  String?
  headerOrder     Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  selectedArticles PulseArticle[] @relation("ArticleSelections")
  selectedBy       PulseArticle[] @relation("ArticleSelections")

  @@map("pulse_articles")
}

model PulseAuthor {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  title       String?
  avatar      String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  articles    PulseArticle[]

  @@map("pulse_authors")
}

model PulseKeyword {
  id       String   @id @default(cuid())
  name     String   @unique
  slug     String   @unique
  articles PulseArticle[]

  @@map("pulse_keywords")
}

model PulseCategory {
  id        String   @id @default(cuid())
  name      Json     @default("{}")
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pulse_categories")
}

// ─── Layihelerimiz (Projects) ────────────────────────────────

model LayihelerimizCategory {
  id            String   @id @default(cuid())
  title         Json     @default("{}")
  slug          String   @unique
  image         String?
  brandImage    String?
  description   Json?
  brand         Json?
  brandTextColor String?  @default("white")
  order         Int      @default(0)
  isVisible     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("layihelerimiz_categories")
}

model LayihelerimizProjectDetail {
  id             String  @id @default(cuid())
  categorySlug   String  @unique

  heroTitle            Json?
  heroDesktopDesc      Json?
  heroMobileDesc       Json?
  heroImages           Json?
  heroCtaText          Json?
  heroCtaLink          String?

  overviewTitleLight      Json?
  overviewTitleBold       Json?
  overviewBrandName       Json?
  overviewDebutText       Json?
  overviewLocationText    Json?
  overviewDebutTextEnd    Json?
  overviewDescription     Json?
  overviewImageLarge      String?
  overviewImageLargeLabel Json?
  overviewImageMedium     String?
  overviewImageMediumLabel Json?
  overviewImageSmall      String?
  overviewImageSmallLabel Json?
  overviewDataRows        Json?

  featuresHeaderMain  Json?
  featuresHeaderSub   Json?
  featuresTitleLight  Json?
  featuresTitleBold   Json?
  featuresSections    Json?
  brochureFile        String?

  locationTitleLight    Json?
  locationTitleBold     Json?
  locationBrandName     Json?
  locationMainLead      Json?
  locationSubText       Json?
  locationMapImage      String?
  locationFooterAddress Json?
  locationGoogleMapsUrl String?

  seoTitle       Json?
  seoDescription Json?
  ogImage        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("layihelerimiz_project_details")
}

model CallbackRequest {
  id        String   @id @default(cuid())
  name      String
  phone     String
  role      String
  createdAt DateTime @default(now())

  @@map("callback_requests")
}

model BrokerRegistration {
  id         Int      @id @default(autoincrement())
  name       String
  email      String
  phone      String
  city       String?
  brokerType String?
  experience String?
  website    String?
  message    String?
  createdAt  DateTime @default(now())

  @@map("broker_registrations")
}
