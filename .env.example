# ============================================================================
# THIS is the file to fill in for deployment (Docker Compose — Hetzner or
# anywhere else). Copy it to `.env` in this same directory, fill in every
# blank value below, then `docker compose up -d --build`. It's the only env
# file the deployment needs — apps/cms-api/.env.example and
# apps/cms-web/.env.example are for running those apps directly on a dev
# machine outside Docker, with their own dev-only placeholder secrets. Never
# reuse those dev values here.
# ============================================================================

# --- Postgres --------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=cms_platform

# --- cms-api -----------------------------------------------------------------
# 32+ random bytes (e.g. `openssl rand -hex 32`).
JWT_SECRET=
# Must equal PANEL_DOMAIN below, with scheme, e.g. https://panel.example.com
CORS_ORIGINS=
# Shared secret the treva_sales_bot sends as `x-api-key` on POST /ingest/*.
INGEST_API_KEY=

# Bot sync (panel <-> treva_sales_bot). SYNC_ENABLED is the single master
# switch for every flow (projects, TREVA Info, pause/resume, manual replies)
# on both sides — see apps/cms-api/.env.example. Shares BOT_SYNC_API_KEY with
# the bot's own SYNC_ENABLED-gated receivers — set the same value in both deployments.
SYNC_ENABLED=0
BOT_KB_WEBHOOK_URL=
BOT_INFO_WEBHOOK_URL=
BOT_BASE_URL=
BOT_SYNC_API_KEY=

# Telegram escalation alerts — posted to your team's group chat with an Accept
# button so two reps never work the same escalation. Separate from SYNC_ENABLED
# on purpose: this notifies humans, it isn't a bot data flow. Create the bot
# with @BotFather, add it to the group, then read the chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates. Button taps arrive by long
# polling, so no public URL is needed — but keep cms-api to ONE replica.
TELEGRAM_ALERTS_ENABLED=0
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
# Panel origin for the alert's "Open in panel" button, with scheme. Must equal
# PANEL_DOMAIN below, e.g. https://panel.example.com
PANEL_BASE_URL=
# IANA zone for timestamps in the alert. Defaults to Asia/Baku.
# TELEGRAM_ALERT_TIMEZONE=Asia/Baku

# --- cms-web -----------------------------------------------------------------
# Build-time only (inlined into the client bundle). Must equal API_DOMAIN
# below, with scheme, e.g. https://api.example.com
NEXT_PUBLIC_API_URL=

# --- Caddy / domains -----------------------------------------------------------
PANEL_DOMAIN=panel.example.com
API_DOMAIN=api.example.com
