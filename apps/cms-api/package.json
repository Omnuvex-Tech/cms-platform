  "scripts": {
    "dev": "node ../../scripts/run-with-env.cjs .env.development @nestjs/cli/bin/nest.js start --watch",
    "build": "node ../../scripts/run-with-env.cjs .env.production @nestjs/cli/bin/nest.js build",
    "format": "prettier --write \"src/**/*.ts\"",
    "prisma:generate": "node ../../scripts/run-prisma.cjs development generate",
    "prisma:migrate:dev": "node ../../scripts/run-prisma.cjs development migrate dev",
    "prisma:migrate:deploy": "node ../../scripts/run-prisma.cjs production migrate deploy",
    "start": "node ../../scripts/run-with-env.cjs .env.production @nestjs/cli/bin/nest.js start",
    "start:dev": "node ../../scripts/run-with-env.cjs .env.development @nestjs/cli/bin/nest.js start --watch",
    "start:debug": "node ../../scripts/run-with-env.cjs .env.development @nestjs/cli/bin/nest.js start --debug --watch",
    "start:prod": "node ../../scripts/run-with-env.cjs .env.production ./dist/src/main.js",
    "lint": "eslint \"{src,apps,libs}/**/*.ts\" --fix",
    "seed": "node ../../scripts/run-with-env.cjs .env.development ts-node/dist/bin.js seed.ts",
    "seed:layihelerimiz": "node ../../scripts/run-with-env.cjs .env.development ts-node/dist/bin.js seed-layihelerimiz.ts",
    "seed:multilingual": "node ../../scripts/run-with-env.cjs .env.development ts-node/dist/bin.js seed-multilingual.ts",
    "seed:project-details": "node ../../scripts/run-with-env.cjs .env.development ts-node/dist/bin.js seed-project-details.ts",
    "seed:pulse": "node ../../scripts/run-with-env.cjs .env.development ts-node/dist/bin.js seed-pulse.ts",
    "seed:all": "npm run seed:layihelerimiz && npm run seed:multilingual && npm run seed:project-details && npm run seed:pulse && npm run seed",
    "translate:pulse": "node ../../scripts/run-with-env.cjs .env.development ts-node/dist/bin.js translate-pulse.ts"
  },
