{
    "name": "cms-platform",
    "private": true,
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev",
        "lint": "turbo run lint",
        "format": "prettier --write \"**/*.{ts,tsx,md}\"",
        "check-types": "turbo run check-types"
    },
    "devDependencies": {
        "@types/bcrypt": "^6.0.0",
        "@types/nodemailer": "^8.0.0",
        "@types/passport-jwt": "^4.0.1",
        "prettier": "^3.7.4",
        "prisma": "^7.8.0",
        "turbo": "^2.9.6",
        "typescript": "5.9.2"
    },
    "engines": {
        "node": ">=18"
    },
    "packageManager": "npm@11.6.2",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "dependencies": {
        "@nestjs/jwt": "^11.0.2",
        "@nestjs/passport": "^11.0.5",
        "@prisma/client": "^7.8.0",
        "bcrypt": "^6.0.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.15.1",
        "nodemailer": "^8.0.10",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1"
    },
    "allowScripts": {
        "@prisma/client": true,
        "@prisma/engines": true,
        "prisma": true,
        "@nestjs/core": true,
        "bcrypt": true,
        "sharp": true
    }
}
