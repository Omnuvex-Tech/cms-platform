DB_URI="postgresql://user:password@host:5432/cms_platform?schema=public"

# 32+ random bytes in production (e.g. `openssl rand -hex 32`). Never reuse the dev value.
JWT_SECRET=

PORT=4000

# Comma-separated list of allowed browser origins, e.g.:
# CORS_ORIGINS=https://panel.example.com
# Required in production — the app refuses to boot without it when NODE_ENV=production.
CORS_ORIGINS=

# Shared secret the treva_sales_bot sends in the `x-api-key` header to POST /ingest/*.
# Generate a random value, e.g. `openssl rand -hex 24`.
INGEST_API_KEY=

# ---------------------------------------------------------------------------
# Panel <-> bot sync (projects, TREVA Info, pause/resume, manual replies).
# SYNC_ENABLED is the single master switch for every one of these flows —
# there's no per-flow flag to dig through. Turn on only once
# BOT_KB_WEBHOOK_URL/BOT_INFO_WEBHOOK_URL/BOT_BASE_URL + BOT_SYNC_API_KEY are set.
# ---------------------------------------------------------------------------
SYNC_ENABLED=0
# Full URL of the bot's KB-sync endpoint (must be reachable from cms-api's host).
BOT_KB_WEBHOOK_URL=
# Full URL of the bot's TREVA Information sync endpoint (same bot, /ingest/info).
BOT_INFO_WEBHOOK_URL=
# Base URL of the bot, used for pause/resume + manual-reply pushes.
BOT_BASE_URL=
# Shared secret sent as `x-api-key` on every push to the bot — must equal the
# same-named var on the bot's side.
BOT_SYNC_API_KEY=
# Optional tuning:
# BOT_SYNC_TIMEOUT_MS=15000
# BOT_SYNC_MAX_ATTEMPTS=4

# Optional override for where TREVA Information sections are written as markdown.
# Only relevant if cms-api shares a filesystem with the treva_sales_bot repo.
# Leave unset in production if it doesn't — writes fail safe and are logged, never thrown.
# TREVA_INFO_MD_PATH=
