# Local dev only — read directly by cms-api when you run it outside Docker
# (`npm run dev` / `nest start`). Deploying via Docker Compose? This file is
# NOT read by docker-compose.yml — fill in the root .env.example instead.

DB_URI="postgresql://user:password@host:5432/cms_platform?schema=public"

# 32+ random bytes in production (e.g. `openssl rand -hex 32`). Never reuse the dev value.
JWT_SECRET=

PORT=4000

# Comma-separated list of allowed browser origins. Only required when
# NODE_ENV=production — local dev falls back to localhost:3000/3001 automatically.
# CORS_ORIGINS=https://panel.example.com

# Shared secret the treva_sales_bot sends in the `x-api-key` header to POST /ingest/*.
# Generate a random value, e.g. `openssl rand -hex 24`.
INGEST_API_KEY=

# ---------------------------------------------------------------------------
# Panel <-> bot sync (projects, TREVA Info, pause/resume, manual replies).
# SYNC_ENABLED is the single master switch for every one of these flows —
# there's no per-flow flag to dig through. Only needed if you're testing sync
# against a bot running locally; turn on once BOT_KB_WEBHOOK_URL/
# BOT_INFO_WEBHOOK_URL/BOT_BASE_URL + BOT_SYNC_API_KEY are set.
# ---------------------------------------------------------------------------
SYNC_ENABLED=0
BOT_KB_WEBHOOK_URL=
BOT_INFO_WEBHOOK_URL=
BOT_BASE_URL=
# Shared secret sent as `x-api-key` on every push to the bot — must equal the
# same-named var on the bot's side.
BOT_SYNC_API_KEY=
# Optional tuning:
# BOT_SYNC_TIMEOUT_MS=15000
# BOT_SYNC_MAX_ATTEMPTS=4

# ---------------------------------------------------------------------------
# Telegram escalation alerts (posted to your team's group chat).
#
# NOT covered by SYNC_ENABLED above — that governs the panel <-> bot data
# flows; this one only notifies humans, so either can run without the other.
# With TELEGRAM_ALERTS_ENABLED=0 nothing is sent and no polling loop starts.
#
# Setup: create a bot with @BotFather, add it to the group, then send any
# message there and read the chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates (a supergroup looks like
# -1001234567890). Verify with `POST /telegram/test` as an admin.
#
# Button taps are received by LONG POLLING, so no public URL or webhook is
# needed — but run only ONE cms-api process per token (Telegram answers 409 to
# concurrent getUpdates).
# ---------------------------------------------------------------------------
TELEGRAM_ALERTS_ENABLED=0
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
# Panel origin for the alert's "Open in panel" link. Telegram rejects a
# localhost button URL, so in dev the link is written into the message text
# instead of onto a button.
PANEL_BASE_URL=
# IANA zone for the timestamps in the alert. Defaults to Asia/Baku.
# TELEGRAM_ALERT_TIMEZONE=Asia/Baku

# Optional override for where TREVA Information sections are written as markdown.
# Only relevant if cms-api shares a filesystem with the treva_sales_bot repo
# (e.g. both cloned as siblings on your dev machine) — not used by the Docker
# deployment, which relies on the /ingest/info webhook above instead.
# TREVA_INFO_MD_PATH=
