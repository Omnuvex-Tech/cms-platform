generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DB_URI")
}

// ---------------------------------------------------------------------------
// Enums (wire values kept identical to the front-end vocabulary in the spec)
// ---------------------------------------------------------------------------

enum Role {
  admin
  sales_rep
}

enum ProjectStatus {
  draft
  published
  archived
}

// Which buyer a project is really sold to. Mirrors `audience` in the bot's
// projects_metadata.json: an `investment` project is dropped for customers
// buying somewhere to live, an `accommodation` one is merely ranked below the
// investment-angled ones for investors (see the bot's matching.py).
enum ProjectAudience {
  investment
  accommodation
  mixed
}

enum Channel {
  webchat
  whatsapp
  telegram
  instagram
  phone
}

enum Language {
  en
  ru
  az
}

enum ConversationStatus {
  active
  waiting_for_human
  assigned
  resolved
  closed
  spam
}

enum MessageRole {
  user
  bot
  human
  system
}

enum HandoffStatus {
  new
  active
  assigned
  resolved
  cancelled
}

enum HandoffPriority {
  normal
  high
  urgent
}

enum SlaState {
  on_track
  due_soon
  breached
}

enum ContactRequestStatus {
  new
  assigned
  contacted
  scheduled
  completed
  no_answer
  cancelled
}

enum LeadStatus {
  new
  qualified
  contact_requested
  assigned
  in_follow_up
  visit_scheduled
  negotiation
  won
  lost
  invalid
}

enum Temperature {
  hot
  warm
  cold
}

enum LeadTimelineType {
  created
  phone_captured
  project_suggested
  handoff_created
  contact_requested
  status_changed
  note_added
}

// ---------------------------------------------------------------------------
// Users (extends the original product_owners table)
// ---------------------------------------------------------------------------

model User {
  id             Int       @id @default(autoincrement())
  email          String    @unique
  password       String
  name           String?
  phone          String?
  role           Role      @default(admin)
  isActive       Boolean   @default(true)
  lastActivityAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  assignedConversations Conversation[]   @relation("ConversationAssignee")
  authoredNotes         InternalNote[]
  assignedHandoffs      Handoff[]        @relation("HandoffAssignee")
  ownedContactRequests  ContactRequest[] @relation("ContactRequestOwner")
  ownedLeads            Lead[]           @relation("LeadOwner")

  @@map("product_owners")
}

// ---------------------------------------------------------------------------
// Projects (the agent's real-estate knowledge base)
// ---------------------------------------------------------------------------

model Project {
  id        Int           @id @default(autoincrement())
  name      String
  slug      String?       @unique
  location  String?
  latitude  Float?
  longitude Float?
  status    ProjectStatus @default(draft)

  // Portfolio-teaser curation, pushed to `tags`/`audience` in the bot's
  // projects_metadata.json. The bot shows ONE project per teaser category, so
  // these decide which projects a customer ever sees; the vocabulary is fixed
  // (PROJECT_TAGS in projects/project-tags.ts) because a tag outside it matches
  // no category and silently does nothing.
  // `audience` is nullable on purpose: null means "not curated here", which is
  // what lets bot-sync leave the bot's own value alone (the bot itself falls
  // back to `mixed` when it has none either).
  tags     String[]
  audience ProjectAudience?

  // Markdown-friendly description fields
  aboutProject         String? @db.Text
  advantages           String? @db.Text
  targetAudience       String? @db.Text
  investmentAdvantages String? @db.Text
  services             String? @db.Text

  // Metadata
  pricePerM2Min         Float?
  pricePerM2Max         Float?
  areaMin               Float?
  areaMax               Float?
  totalPriceMin         Float?
  totalPriceMax         Float?
  readyToMoveIn         Boolean @default(false)
  completionYear        Int?
  handoverCondition     String?
  paymentPlanAvailable  Boolean @default(false)
  bulkDiscountAvailable Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bedroomPricing     BedroomPricing[]
  standardPlans      StandardPaymentPlan[]
  internationalTiers InternationalPlanTier[]

  @@map("projects")
}

model BedroomPricing {
  id        Int     @id @default(autoincrement())
  projectId Int
  label     String
  areaMin   Float?
  areaMax   Float?
  priceMin  Float?
  priceMax  Float?
  note      String?
  sortOrder Int     @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("bedroom_pricing")
}

model StandardPaymentPlan {
  id                Int    @id @default(autoincrement())
  projectId         Int
  downPaymentPct    Float?
  discountPct       Float?
  installmentMonths Int?
  optionDiscountPct Float?
  sortOrder         Int    @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("standard_payment_plans")
}

model InternationalPlanTier {
  id                 Int    @id @default(autoincrement())
  projectId          Int
  downPaymentPct     Float?
  discountPct        Float?
  interestFreeMonths Int?
  sortOrder          Int    @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("international_plan_tiers")
}

// ---------------------------------------------------------------------------
// TREVA Information (single company-info record, made of freely editable
// headed sections mirroring the bot's about_treva.md knowledge-base file)
// ---------------------------------------------------------------------------

model TrevaInfo {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections TrevaInfoSection[]

  @@map("treva_info")
}

model TrevaInfoSection {
  id          Int      @id @default(autoincrement())
  trevaInfoId Int
  heading     String
  content     String   @db.Text
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  trevaInfo TrevaInfo @relation(fields: [trevaInfoId], references: [id], onDelete: Cascade)

  @@map("treva_info_sections")
}

// ---------------------------------------------------------------------------
// Conversations
// ---------------------------------------------------------------------------

model Conversation {
  id             Int                @id @default(autoincrement())
  threadId       String             @unique
  channel        Channel
  language       Language           @default(en)
  status         ConversationStatus @default(active)
  customerHandle String?
  customerPhone  String?
  stage          String?
  budget         String?
  // Bot-derived trace fields: the project the customer is focused on and the
  // concrete units they picked (customer-facing apartment numbers, e.g. "C-410").
  topProject     String?
  selectedUnits  String[]
  botActive      Boolean            @default(true)
  unreadCount    Int                @default(0)
  lastMessageAt  DateTime           @default(now())
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  assignedToId Int?
  assignedTo   User? @relation("ConversationAssignee", fields: [assignedToId], references: [id])

  leadId Int?
  lead   Lead? @relation(fields: [leadId], references: [id])

  messages        Message[]
  notes           InternalNote[]
  handoff         Handoff?
  contactRequests ContactRequest[]

  @@map("conversations")
}

model Message {
  id             Int         @id @default(autoincrement())
  conversationId Int
  role           MessageRole
  content        String      @db.Text
  channel        Channel?
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model InternalNote {
  id             Int      @id @default(autoincrement())
  conversationId Int
  authorId       Int?
  body           String   @db.Text
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       User?        @relation(fields: [authorId], references: [id])

  @@map("internal_notes")
}

// ---------------------------------------------------------------------------
// Handoff Queue
// ---------------------------------------------------------------------------

model Handoff {
  id             Int             @id @default(autoincrement())
  conversationId Int             @unique
  status         HandoffStatus   @default(new)
  priority       HandoffPriority @default(normal)
  slaState       SlaState        @default(on_track)
  reason         String?         @db.Text
  notes          String?         @db.Text
  dueAt          DateTime?
  resolvedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  assignedToId Int?
  assignedTo   User? @relation("HandoffAssignee", fields: [assignedToId], references: [id])

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  // The alert posted to the Telegram ops group for this handoff, if any.
  telegramAlert TelegramAlert?

  @@map("handoffs")
}

/**
 * One escalation alert posted to the Telegram ops group, remembered so the same
 * message can be edited in place when the handoff is claimed or resolved —
 * that edit is what stops two people working the same escalation.
 *
 * 1:1 with its handoff. A handoff row is reused when a conversation escalates
 * again (see IngestService.handleEscalation), so a re-escalation overwrites
 * this row with the new message's coordinates and clears the claim.
 */
model TelegramAlert {
  id        Int    @id @default(autoincrement())
  handoffId Int    @unique
  // Telegram chat/user ids are 64-bit; kept as text so a supergroup id
  // (-100…) never rides on JS number precision.
  chatId    String
  messageId Int
  // The alert's text as first posted, frozen. Claim/resolve edits re-send this
  // verbatim with a new status footer, so an edit can only ever ADD to what the
  // group already read. Re-deriving it from the conversation instead would let
  // a later bot push that omits a field (name, budget) silently shrink an alert
  // people have already acted on.
  body      String @db.Text

  claimedBy  String?
  claimedAt  DateTime?
  resolvedBy String?
  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  handoff Handoff @relation(fields: [handoffId], references: [id], onDelete: Cascade)

  @@map("telegram_alerts")
}

// ---------------------------------------------------------------------------
// Contact Requests (callback promises)
// ---------------------------------------------------------------------------

model ContactRequest {
  id               Int                  @id @default(autoincrement())
  // Stable idempotency key = the bot's contact-request request_id. Null for any
  // rows created outside the bot ingest path.
  externalId       String?              @unique
  customerPhone    String
  preferredChannel Channel              @default(phone)
  availabilityText String?
  availabilityAt   DateTime?
  isFlexible       Boolean              @default(false)
  status           ContactRequestStatus @default(new)
  customerWords    String?              @db.Text
  followUpOutcome  String?              @db.Text
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  ownerId Int?
  owner   User? @relation("ContactRequestOwner", fields: [ownerId], references: [id])

  conversationId Int?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])

  leadId Int?
  lead   Lead? @relation(fields: [leadId], references: [id])

  @@map("contact_requests")
}

// ---------------------------------------------------------------------------
// Leads (the CRM hub)
// ---------------------------------------------------------------------------

model Lead {
  id                 Int         @id @default(autoincrement())
  name               String?
  surname            String?
  phone              String?
  threadId           String?
  channel            Channel
  topProject         String?
  budget             String?
  budgetFlexible     Boolean     @default(false)
  budgetRaw          String?
  purpose            String?
  bedrooms           String?
  location           String?
  timeframe          String?
  language           Language    @default(en)
  interestedProjects String[]
  botNotes           String?     @db.Text
  salesStatus        LeadStatus  @default(new)
  temperature        Temperature @default(warm)
  nextAction         String?     @db.Text
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  ownerId Int?
  owner   User? @relation("LeadOwner", fields: [ownerId], references: [id])

  timeline        LeadTimelineEvent[]
  conversations   Conversation[]
  contactRequests ContactRequest[]

  @@map("leads")
}

model LeadTimelineEvent {
  id          Int              @id @default(autoincrement())
  leadId      Int
  type        LeadTimelineType
  description String           @db.Text
  createdAt   DateTime         @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("lead_timeline_events")
}
