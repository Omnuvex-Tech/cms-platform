# Compose-level config — read by docker-compose.yml for ${VAR} substitution.
# This is DELIBERATELY separate from apps/cms-api/.env and apps/cms-web/.env.example
# (those are for running the apps directly on a dev machine, with dev-only
# placeholder secrets). Never reuse those dev values here — copy this file to
# `.env` next to docker-compose.yml and fill in real production values.

# --- Postgres --------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=cms_platform

# --- cms-api -----------------------------------------------------------------
# 32+ random bytes (e.g. `openssl rand -hex 32`).
JWT_SECRET=
# Must equal PANEL_DOMAIN below, with scheme, e.g. https://panel.example.com
CORS_ORIGINS=
# Shared secret the treva_sales_bot sends as `x-api-key` on POST /ingest/*.
INGEST_API_KEY=

# Bot sync (panel <-> treva_sales_bot). Off by default; see apps/cms-api/.env.example
# for what each flow does. Shares BOT_SYNC_API_KEY with the bot's KB_SYNC_ENABLED /
# INFO_SYNC_ENABLED settings — set the same value in both deployments.
SYNC_ENABLED=0
BOT_KB_WEBHOOK_URL=
BOT_INFO_WEBHOOK_URL=
BOT_BASE_URL=
BOT_SYNC_API_KEY=

# --- cms-web -----------------------------------------------------------------
# Build-time only (inlined into the client bundle). Must equal API_DOMAIN
# below, with scheme, e.g. https://api.example.com
NEXT_PUBLIC_API_URL=

# --- Caddy / domains -----------------------------------------------------------
PANEL_DOMAIN=panel.example.com
API_DOMAIN=api.example.com
